{
  "info": {
    "name": "URL Shortener",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Shorten URL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('has 7-char code', () => pm.expect(body.shortCode).to.match(/^[A-Za-z0-9]{7}$/));",
              "pm.collectionVariables.set('code', body.shortCode);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/shorten",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shorten"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com\"\n}"
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "Shorten invalid URL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/shorten",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shorten"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"ftp://example.com\"\n}"
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "Shorten with past expiresAt",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/shorten",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shorten"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com\",\n  \"expiresAt\": \"2000-01-01T00:00:00Z\"\n}"
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "Redirect",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('301 Moved Permanently', () => pm.response.to.have.status(301));",
              "pm.test('Location is original URL', () => pm.expect(pm.response.headers.get('Location')).to.eql('https://example.com'));",
              "pm.test('no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Referer",
            "value": "https://google.com"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/{{code}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{code}}"
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "Redirect unknown code",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/zzzzzzz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "zzzzzzz"
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "List URLs",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const link = pm.response.json().find(u => u.shortCode === pm.collectionVariables.get('code'));",
              "pm.test('contains created link with clicks', () => pm.expect(link.clickCount).to.be.at.least(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/urls",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "urls"
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "Stats",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('counts clicks', () => pm.expect(body.totalClicks).to.be.at.least(1));",
              "pm.test('30 days', () => pm.expect(body.clicksByDay).to.have.lengthOf(30));",
              "pm.test('google referrer', () => pm.expect(body.topReferrers.map(r => r.referrer)).to.include('https://google.com'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/stats/{{code}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stats",
            "{{code}}"
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "Stats unknown code",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/stats/zzzzzzz",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stats",
            "zzzzzzz"
          ]
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    }
  ]
}